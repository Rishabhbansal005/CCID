SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

SECRET_KEY=your-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development
LOG_LEVEL=debug

# Storage
STORAGE_BUCKET=forensic_uploads
MAX_FILE_SIZE_MB=500

# Optional: Forensic Tool Paths (for future integration)
VOLATILITY_PATH=/usr/local/bin/vol
WIRESHARK_PATH=/usr/bin/wireshark
AUTOPSY_API_URL=http://localhost:9999/api
FTK_API_URL=http://localhost:8888/api
